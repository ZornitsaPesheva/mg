rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tracker/data {
      // The tracker is intentionally public read-only for visitors.
      allow get: if true;
      allow list: if false;

      // Replace the UID below with the administrator's Firebase Auth UID.
      allow create, update: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'
        && request.resource.data.keys().hasAll(['cars'])
        && request.resource.data.keys().hasOnly(['cars'])
        && request.resource.data.cars is list;

      // A car is removed by updating the array; the tracker document itself cannot be deleted.
      allow delete: if false;
    }

    // Deny every other document by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
