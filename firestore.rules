rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tracker/data {
      // The tracker is intentionally public read-only for visitors.
      allow get: if true;
      allow list: if false;

      allow create, update: if request.auth != null
        && request.auth.uid in [
          'Bsrl0QKJl8OGpJBDJzrN4jIC3ay2',
          'HqNbE0a1pjVtkvNVz7YX57L8sfB3'
        ]
        && request.resource.data.keys().hasAll(['cars'])
        && request.resource.data.keys().hasOnly(['cars'])
        && request.resource.data.cars is list;

      // A car is removed by updating the array; the tracker document itself cannot be deleted.
      allow delete: if false;
    }

    // Deny every other document by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
